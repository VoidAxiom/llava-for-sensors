// architecture/container.c4 — llava-for-sensors container decomposition.
//
// Extends the `llava` system defined in landscape.c4. Each container
// corresponds to one top-level production-code directory:
//
//   data/   → data_pipeline
//   models/ → ts_encoder, fusion, vlm
//   train/  → train_loop
//   eval/   → eval_harness
//   demo/   → demo_app
//
// Phase notes are descriptive — they document what the container DOES
// across all phases, not what's implemented at any given moment.

model {
  extend llava {
    data_pipeline = container 'Data Pipeline' {
      description '
        Loads CWRU windows (2048 samples each); stratified 80/10/10
        split with seed=0; pairs each window with a representative
        equipment image and a deterministically synthesized technician
        note. Also exposes the Phase-1 toy synthetic dataset whose
        anomaly signature requires fusion by construction.
      '
    }

    ts_encoder = container 'Time-Series Encoder' {
      description '
        Encodes a 2048-sample window into token-space embeddings.
        Phase 1 starts with a toy 1D-CNN to smoke-test the full
        pipeline; Phase 2 swaps to PatchTST (preferred) or Moment-small.
      '
    }

    fusion = container 'Fusion Adapter' {
      description '
        The single trainable projection that maps the time-series
        encoder output into the frozen Qwen2-VL-2B token space. Small,
        ~M-parameter range. Conceptually the heart of LLaVA-for-sensors.
      '
    }

    vlm = container 'Qwen2-VL-2B (frozen) + LoRA + Head' {
      description '
        Frozen Qwen2-VL-2B base, low-rank adapters on its attention
        projections, plus a 4-class classification head consuming the
        pooled multimodal token sequence. Only the LoRA weights, the
        head, the fusion adapter, and the TS encoder train; the base
        VLM stays frozen across all conditions.
      '
    }

    train_loop = container 'Training Loop' {
      description '
        Drives optimization across the headline-ablation grid: three
        modality conditions (sensors-only, vision+text, all-three) ×
        five seeds = 15 runs in Phase 4. Targets ≤ 40 GB peak memory
        and ≤ 24h total wall time on M2 Max.
      '
    }

    eval_harness = container 'Eval Harness' {
      description '
        Pre-registered headline-figure logic per PLAN.md §1: macro-F1
        across 5 seeds with 95% percentile bootstrap CI (10,000
        resamples), paired bootstrap p-value for the all-three vs
        vision+text comparison, and a deterministic pass/fail verdict
        encoded in eval/test_headline.py (P0.7).
      '
    }

    demo_app = container 'Gradio Demo' {
      description '
        Local Gradio app shipped in Phase 5. Accepts a sensor CSV and
        an equipment image, returns the predicted fault class and a
        short rationale generated by the frozen VLM conditioned on the
        fused tokens.
      '
    }

    // Internal relations — training time.
    data_pipeline -> ts_encoder 'sensor windows'
    ts_encoder -> fusion 'time-series tokens'
    fusion -> vlm 'projected tokens (in VLM token space)'
    train_loop -> data_pipeline 'iterates training split'
    train_loop -> ts_encoder 'optimizes encoder weights'
    train_loop -> fusion 'optimizes the adapter projection'
    train_loop -> vlm 'optimizes LoRA + classification head'

    // Eval-time.
    eval_harness -> data_pipeline 'loads held-out test split'
    eval_harness -> vlm 'inference across 5 seeds × 3 conditions'

    // Demo-time.
    demo_app -> ts_encoder 'encode the uploaded sensor CSV'
    demo_app -> vlm 'predict + rationale for the uploaded image'
  }
}

views {
  view container of llava {
    title 'Container View — llava-for-sensors'
    include *
    autoLayout TopBottom
  }
}
