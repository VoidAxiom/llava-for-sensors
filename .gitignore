
# --- agent orchestration (append to the target repo's .gitignore) ---
.codex-runs/

# runtime hook breadcrumbs (generated; .claude/settings.json IS tracked)
.claude/hooks/

# LikeC4 static-website build artifacts (we ship the Mermaid renders, not the
# interactive site; regenerate locally with `likec4 build architecture -o docs/architecture`).
# The Mermaid files (landscape.mmd, container.mmd) ARE tracked.
docs/architecture/404.html
docs/architecture/favicon.ico
docs/architecture/index.html
docs/architecture/robots.txt
docs/architecture/likec4-views.js
docs/architecture/assets/
# Auto-generated alias of the first named view; landscape.mmd is the real source.
docs/architecture/index.mmd

# Python — uv-managed venv + interpreter caches + tooling caches.
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# Node — installed deps. The lockfile (package-lock.json) IS tracked.
node_modules/

# ML caches — local-only model weights / tokenizer caches that don't belong in git.
# (HuggingFace caches default to ~/.cache/huggingface; uncomment a project-local
# entry here if any future packet redirects them under the repo.)
.cache/

# Understand-Anything — knowledge-graph.json + meta.json + fingerprints.json +
# .understandignore ARE tracked. intermediate/, tmp/, and diff-overlay.json are
# per-run scratch (/understand-diff writes the overlay each invocation; commit-
# ing transient overlay data would dirty `git status` and bloat history).
.understand-anything/intermediate/
.understand-anything/tmp/
.understand-anything/diff-overlay.json
# Dashboard runtime-verification screenshots — gitignored evidence, not deliverables.
.understand-anything/*-verification.png
